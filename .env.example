# Copy to .env and fill in. Never commit .env.

# OpenRouter API key (https://openrouter.ai/keys), or the key of another OpenAI-compatible gateway
LLM_API_KEY=
# Gateway root URL
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model used by the agents, in the gateway's naming; on OpenRouter for example
# google/gemini-3.8-flash, openai/gpt-6.1-sol, qwen/qwen3.8-max-prime
LLM_MODEL_ID=google/gemini-3.8-flash

# Optional: proxy to reach the gateway; used only with BYPASS_SYSTEM_PROXY = False in config.py
# HTTP_PROXY=
# HTTPS_PROXY=

# Tracing in a local Phoenix collector (http://localhost:6006)
# PHOENIX_ENABLED=1
