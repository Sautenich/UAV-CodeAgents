# Copy to .env and fill in. Never commit .env.

# Key of the OpenAI-compatible gateway that serves the planning models
LLM_API_KEY=
# Gateway root URL (any OpenAI-compatible provider)
LLM_BASE_URL=https://ai.starimg.ru/v1
# Model used by the agents, e.g. gemini-3.8-flash, gpt-6.1-sol, qwen3.8-max
LLM_MODEL_ID=gemini-3.8-flash

# Optional: proxies, if your network needs them
# HTTP_PROXY=
# HTTPS_PROXY=

# Tracing in a local Phoenix collector (http://localhost:6006)
# PHOENIX_ENABLED=1
